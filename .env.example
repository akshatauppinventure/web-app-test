# Copy to .env (gitignored). Read by `docker compose -f compose.dev.yaml` for variable substitution.
# Google OAuth client "local" (owner prerequisite P2): client id is public, the secret goes into
# .dev-secrets/app_google_client_secret (see docs/dev-setup.md).
GOOGLE_CLIENT_ID=unset-google-client-id.apps.googleusercontent.com
