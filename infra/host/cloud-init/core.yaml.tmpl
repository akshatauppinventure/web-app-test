packages:
  - docker-ce
  - docker-ce-cli
  - containerd.io
  - docker-compose-plugin
  - wireguard-tools
  - nftables
  - unattended-upgrades
  - auditd
  - apparmor
  - apparmor-utils
  - jq
  - curl
  - openssl
  - iptables
  - restic

write_files:
  - path: /etc/app/host.env
    permissions: "0644"
    content: |
      HOST_ROLE=core
      PEER_IP=10.10.0.1
      PUBLIC_HOST=__PUBLIC_HOST__
      PUBLIC_IF=__PUBLIC_IF__
      NOTIFY_WEBHOOK_URL=
  - path: /etc/docker/daemon.json
    permissions: "0644"
    content: |
__DAEMON_JSON__
  - path: /etc/nftables.conf
    permissions: "0644"
    content: |
__NFT_RULES__
  - path: /etc/wireguard/wg0.conf.tmpl
    permissions: "0600"
    content: |
__WG_TEMPLATE__
  - path: /etc/wireguard/psk-map
    permissions: "0600"
    content: |
      # <peer public key> <psk file in /etc/wireguard>  (filled during provisioning, T20)
  - path: /usr/local/sbin/docker-user-rules.sh
    permissions: "0755"
    content: |
__DOCKER_USER_RULES__
  - path: /usr/local/sbin/wg-apply-psks.sh
    permissions: "0755"
    content: |
__WG_APPLY_PSKS__
  - path: /usr/local/sbin/wg-rotate-key.sh
    permissions: "0755"
    content: |
__WG_ROTATE_KEY__
  - path: /usr/local/sbin/resolve-public-if.sh
    permissions: "0755"
    content: |
__RESOLVE_PUBLIC_IF__
  - path: /usr/local/sbin/boot-report.sh
    permissions: "0755"
    content: |
__BOOT_REPORT__
  - path: /usr/local/sbin/healthcheck.sh
    permissions: "0755"
    content: |
__HEALTHCHECK__
  - path: /etc/systemd/system/docker-user-rules.service
    permissions: "0644"
    content: |
__UNIT_DOCKER_USER_RULES__
  - path: /etc/systemd/system/docker.service.d/wireguard.conf
    permissions: "0644"
    content: |
__UNIT_DOCKER_DROPIN__
  - path: /etc/systemd/system/healthcheck.service
    permissions: "0644"
    content: |
__UNIT_HEALTHCHECK_SERVICE__
  - path: /etc/systemd/system/healthcheck.timer
    permissions: "0644"
    content: |
__UNIT_HEALTHCHECK_TIMER__
  - path: /usr/local/sbin/pg-backup.sh
    permissions: "0755"
    content: |
__PG_BACKUP__
  - path: /usr/local/sbin/restic-check.sh
    permissions: "0755"
    content: |
__RESTIC_CHECK__
  - path: /usr/local/sbin/restore-drill.sh
    permissions: "0755"
    content: |
__RESTORE_DRILL__
  - path: /etc/systemd/system/pg-backup.service
    permissions: "0644"
    content: |
__UNIT_PG_BACKUP_SERVICE__
  - path: /etc/systemd/system/pg-backup.timer
    permissions: "0644"
    content: |
__UNIT_PG_BACKUP_TIMER__
  - path: /etc/systemd/system/restic-check.service
    permissions: "0644"
    content: |
__UNIT_RESTIC_CHECK_SERVICE__
  - path: /etc/systemd/system/restic-check.timer
    permissions: "0644"
    content: |
__UNIT_RESTIC_CHECK_TIMER__
  - path: /etc/app/bootstrap/portainer-server.compose.yaml
    permissions: "0644"
    content: |
__BOOTSTRAP_COMPOSE__
  - path: /etc/ssh/sshd_config.d/10-hardening.conf
    permissions: "0644"
    content: |
      # ADR-0004: keys only, admin user only, WireGuard address only (ip_nonlocal_bind lets sshd
      # start before wg0 exists; nftables allows 22 only on wg0 anyway)
      ListenAddress 10.10.0.2
      PermitRootLogin no
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      PubkeyAuthentication yes
      AllowUsers __ADMIN_USER__
      X11Forwarding no
      AllowAgentForwarding no
      AllowTcpForwarding yes
      MaxAuthTries 3
      LoginGraceTime 30
      ClientAliveInterval 300
      ClientAliveCountMax 2
  - path: /etc/systemd/system/ssh.service.d/wireguard.conf
    permissions: "0644"
    content: |
      [Unit]
      After=wg-quick@wg0.service
      Wants=wg-quick@wg0.service
  - path: /etc/sysctl.d/90-hardening.conf
    permissions: "0644"
    content: |
      kernel.kptr_restrict = 2
      kernel.dmesg_restrict = 1
      kernel.unprivileged_bpf_disabled = 1
      net.ipv4.conf.all.rp_filter = 1
      net.ipv4.conf.default.rp_filter = 1
      net.ipv4.conf.all.accept_redirects = 0
      net.ipv4.conf.default.accept_redirects = 0
      net.ipv4.conf.all.send_redirects = 0
      net.ipv4.conf.default.send_redirects = 0
      net.ipv4.conf.all.accept_source_route = 0
      net.ipv6.conf.all.accept_redirects = 0
      net.ipv6.conf.all.accept_ra = 0
      net.ipv4.tcp_syncookies = 1
      net.ipv4.ip_nonlocal_bind = 1
      net.ipv4.ip_forward = 1
  - path: /etc/apt/apt.conf.d/52unattended-upgrades-local
    permissions: "0644"
    content: |
      // ADR-0004: security updates daily; reboot at 04:00 UTC (00:00 America/New_York during EDT)
      Unattended-Upgrade::Automatic-Reboot "true";
      Unattended-Upgrade::Automatic-Reboot-Time "04:00";
      Unattended-Upgrade::Remove-Unused-Dependencies "true";
      Unattended-Upgrade::Allowed-Origins {
        "${distro_id}:${distro_codename}-security";
        "${distro_id}ESMApps:${distro_codename}-apps-security";
        "${distro_id}ESM:${distro_codename}-infra-security";
        "Docker:${distro_codename}";
      };

runcmd:
  # sysctl + nftables first (policy DROP before Docker starts)
  - sysctl --system
  # Public interface name differs per provider (UpCloud/OVH): resolve "auto" from the default route first
  - /usr/local/sbin/resolve-public-if.sh /etc/nftables.conf /etc/app/host.env
  - systemctl enable --now nftables
  # WireGuard: the bootstrap key pair was rendered into user_data so every peer is valid at first boot (T20);
  # the admin replaces it on first contact with wg-rotate-key.sh (key generated here, never leaves the host)
  - umask 077 && sed -n 's/^PrivateKey = //p' /etc/wireguard/wg0.conf.tmpl | head -1 > /etc/wireguard/private.key && wg pubkey < /etc/wireguard/private.key > /etc/wireguard/public.key
  - install -m 600 /etc/wireguard/wg0.conf.tmpl /etc/wireguard/wg0.conf
  - systemctl enable --now wg-quick@wg0
  - systemctl daemon-reload
  - systemctl restart ssh
  # Docker: ordering drop-in, hardened daemon.json, DOCKER-USER rules, docker group for the admin
  - usermod -aG docker __ADMIN_USER__
  - systemctl enable --now docker
  - systemctl enable --now docker-user-rules.service
  # Secrets directory (populated out of band by scripts/secrets/secrets-push.sh, T19)
  - install -d -m 0700 -o root -g root /etc/app/secrets
  - install -d -m 0755 /var/lib/app
  # Timers
  - systemctl enable --now healthcheck.timer
  - systemctl enable --now pg-backup.timer restic-check.timer
  # Portainer bootstrap starts once the secrets exist (T21 runbook): docker compose -p portainer -f /etc/app/bootstrap/portainer-server.compose.yaml up -d
  - echo "cloud-init finished for core; public key $(cat /etc/wireguard/public.key)" > /var/log/cloud-init-summary.log
  # Diagnostics on the VNC console (tty1): reachable through the provider API when the tunnel is not
  - /usr/local/sbin/boot-report.sh || true

final_message: "web-app-test core host ready after $UPTIME seconds (public WireGuard key in /etc/wireguard/public.key)"
