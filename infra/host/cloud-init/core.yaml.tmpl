#cloud-config
# VPS-B (core) first-boot configuration (ADR-0004, ADR-0005, ADR-0006, ADR-0014, ADR-0015,
# ADR-0021, ADR-0024). Rendered by infra/host/scripts/render-cloud-init.sh from a vars file; the
# placeholders are substituted there and the repo's scripts/units/configs are embedded.
# Secrets are never part of this file (T19 pushes them out of band).
hostname: __HOSTNAME__
timezone: Etc/UTC
locale: C.UTF-8
package_update: true
package_upgrade: true
package_reboot_if_required: false

# Early, detached progress reporter on the VNC console (tty1): write_files lands boot-report.sh a few
# seconds after bootcmd, so the loop waits before its first run and stops once cloud-init is done (T20).
bootcmd:
  - [ sh, -c, "nohup sh -c 'sleep 75; exec /usr/local/sbin/boot-report.sh --loop' >/dev/null 2>&1 &" ]

users:
  - name: __ADMIN_USER__
    groups: [sudo]
    shell: /bin/bash
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    lock_passwd: true
    ssh_authorized_keys:
      - __ADMIN_SSH_PUBKEY__
disable_root: true
ssh_pwauth: false

