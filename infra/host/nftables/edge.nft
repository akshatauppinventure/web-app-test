#!/usr/sbin/nft -f
# VPS-A "edge" host firewall (ADR-0014 layer 2, ADR-0026). Input/forward policy DROP; IPv6 dropped except
# ICMPv6 essentials. Public interface name is substituted by cloud-init (__PUBLIC_IF__).
flush ruleset

define PUBLIC_IF = "__PUBLIC_IF__"
define ADMIN_SSH_SOURCES = { __ADMIN_SSH_CIDRS__ }

table inet filter {
  # New SSH connections per source address (ADR-0026): at most 10 per minute, burst 5
  set ssh_rate {
    type ipv4_addr
    flags dynamic, timeout
    timeout 1m
    size 65535
  }

  chain input {
    type filter hook input priority filter; policy drop;

    iif "lo" accept
    ct state established,related accept
    ct state invalid drop

    # ICMP essentials, rate-limited echo
    ip protocol icmp icmp type { destination-unreachable, time-exceeded, parameter-problem } accept
    ip protocol icmp icmp type echo-request limit rate 10/second accept
    ip6 nexthdr icmpv6 icmpv6 type { destination-unreachable, packet-too-big, time-exceeded, parameter-problem, nd-neighbor-solicit, nd-neighbor-advert } accept

    # HTTP/HTTPS reach Traefik through Docker's DNAT (forward path, DOCKER-USER), not this chain.

    # Admin SSH (keys only) from the allowed sources, rate-limited per source address (ADR-0026)
    iifname $PUBLIC_IF ip saddr $ADMIN_SSH_SOURCES tcp dport 22 ct state new add @ssh_rate { ip saddr limit rate 10/minute burst 5 packets } accept

    # Everything else (including IPv6 and any port Docker might publish on the host) is dropped.
    counter drop
  }

  chain forward {
    type filter hook forward priority filter; policy drop;
    # Docker inserts its own forward rules via iptables-nft (table ip filter, chain DOCKER-USER).
    # This chain only sees what Docker did not already accept/drop; keep the default DROP.
    ct state established,related accept
    ct state invalid drop
    counter drop
  }

  chain output {
    type filter hook output priority filter; policy accept;
  }
}
