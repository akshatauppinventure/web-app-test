# /etc/wireguard/wg0.conf on VPS-B (rendered by cloud-init; ADR-0015). Bootstrap key rendered at provisioning, rotated on the host by wg-rotate-key.sh.
[Interface]
Address = 10.10.0.2/24
ListenPort = __WG_PORT__
PrivateKey = __WG_PRIVATE_KEY__
PostUp = /usr/local/sbin/wg-apply-psks.sh %i

# VPS-A (edge) — public key and endpoint set during provisioning (T20)
[Peer]
PublicKey = __EDGE_PUBLIC_KEY__
AllowedIPs = 10.10.0.1/32
Endpoint = __EDGE_ENDPOINT__
PersistentKeepalive = 25

# Admin: owner-laptop
[Peer]
PublicKey = __ADMIN_PUBLIC_KEY__
AllowedIPs = 10.10.0.10/32
