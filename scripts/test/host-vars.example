# Example variables for infra/host/scripts/render-cloud-init.sh (test values only)
HOSTNAME=edge-test
ADMIN_USER=admin
ADMIN_SSH_PUBKEY="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIEXAMPLEEXAMPLEEXAMPLEEXAMPLEEXAMPLEEXAMPLEEX test@example"
PUBLIC_HOST=test-vinayak.duckdns.org
PUBLIC_IF=eth0   # or auto (resolved from the default route at first boot)
EDGE_PRIVATE_IP=10.0.0.11   # private-network addresses (both OpenTofu modules use these defaults)
CORE_PRIVATE_IP=10.0.0.2
ADMIN_SSH_CIDRS=0.0.0.0/0   # comma-separated IPv4 CIDRs allowed to reach SSH; narrow to your address
