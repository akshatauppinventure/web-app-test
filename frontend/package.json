{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js frontend (BFF) for the secure 2-VPS web app POC",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:next-version": "node --disable-warning=ExperimentalWarning scripts/check-next-version.mts",
    "check": "pnpm check:next-version && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "next": "16.3.2",
    "next-auth": "5.0.0-beta.32",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.2",
    "typescript": "5.9.3",
    "vitest": "5.0.0"
  }
}
