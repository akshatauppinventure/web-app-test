# Copy to .env.local for `pnpm dev` (never commit .env.local). In containers these come from
# Compose environment + secret files (T09 / T16).
AUTH_URL=http://localhost:3000
AUTH_SECRET=change-me-32-bytes-random            # or AUTH_SECRET_FILE=/run/secrets/auth_secret
AUTH_KEYCLOAK_ID=web-bff
AUTH_KEYCLOAK_SECRET=test-only-web-bff-client-secret   # or AUTH_KEYCLOAK_SECRET_FILE=/run/secrets/web_bff_client_secret
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/auth/realms/app
# Same realm over the internal network (token/userinfo calls); defaults to the issuer.
KEYCLOAK_INTERNAL_ISSUER=http://localhost:8080/auth/realms/app
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_APPLE_LOGIN=false
